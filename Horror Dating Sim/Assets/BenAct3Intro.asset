  _spriteCount: 1
  _dialogueLines:
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 21300000, guid: de5d207350c794be486f4fffe7f061b2, type: 3}
