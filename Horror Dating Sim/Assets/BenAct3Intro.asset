    hasSFX: 0
    soundEffect: {fileID: 8300000, guid: 57219506f5822de43b8c7a9d4e6b1e3d, type: 3}
    _line: '(There''s not really any room for negotiation here, is there? If I screamed,
      the people inside might hear me, but what would Ben do then?)

'
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
