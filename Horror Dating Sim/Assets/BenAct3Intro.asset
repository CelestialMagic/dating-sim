    hasSFX: 0
    soundEffect: {fileID: 8300000, guid: e643483e11de3ff4d85defdb6bbe7629, type: 3}
    _line: Ben, I don't know what's gotten into you, but I think you need help right
      now. I think I need to go, and you need to-
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
    - _spriteIndex: 0
      IsSubject:
        _isEnabled: 1
        _value: 1
      IsRevealed:
        _isEnabled: 1
        _value: 1
      HasArrived:
        _isEnabled: 1
        _value: 1
      StartingAnchorPosition:
        _isEnabled: 0
        _value: {x: 0, y: 0}
      StartingDimensions:
        _isEnabled: 1
        _value: {x: 750, y: 900}
      ImageSearchParameters:
        _isEnabled: 1
        _value:
          _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
          _imageType: 5
          _version: 1
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 21300000, guid: de5d207350c794be486f4fffe7f061b2, type: 3}
    hasSFX: 1
    soundEffect: {fileID: 8300000, guid: b949ebd089be19a4e8da79030c7a5172, type: 3}
    _line: No, see, that's exactly it. The only thing I need right now is your cooperation.
      And I'd hate to force your hand, but this is the only way you'll listen.
    _speakerProperties:
    - _speakerType: 2
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
    - _spriteIndex: 0
      IsSubject:
        _isEnabled: 1
        _value: 1
      IsRevealed:
        _isEnabled: 1
        _value: 1
      HasArrived:
        _isEnabled: 1
        _value: 1
      StartingAnchorPosition:
        _isEnabled: 0
        _value: {x: 0, y: 0}
      StartingDimensions:
        _isEnabled: 1
        _value: {x: 750, y: 900}
      ImageSearchParameters:
        _isEnabled: 1
        _value:
          _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
          _imageType: 5
          _version: 1
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 21300000, guid: de5d207350c794be486f4fffe7f061b2, type: 3}
    hasSFX: 1
    soundEffect: {fileID: 8300000, guid: 52718351f1297a647a7bffcb0c4a4b0f, type: 3}
    _line: '(With a burst of speed, Ben reaches his hand into your pocket, grabs
      your car keys, and thrusts them into the pool.)

'
    _speakerProperties:
    - _speakerType: 0
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
