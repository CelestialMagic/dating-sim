  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 21300000, guid: a877b818a040d48cfad7800ec1022fdd, type: 3}
    hasSFX: 1
    soundEffect: {fileID: 8300000, guid: 322244cc69baa4e3180200e7cb338d51, type: 3}
    _line: ...And that's the five o'clock news. After the break, more on the tragic
      disappearance of two college students. The authorities report that...
    _speakerProperties:
    - _speakerType: 0
      _name: News Broadcast
