        _value: 0
      HasArrived:
        _isEnabled: 1
        _value: 0
      StartingAnchorPosition:
        _isEnabled: 0
        _value: {x: 0, y: 0}
      StartingDimensions:
        _isEnabled: 1
        _value: {x: 750, y: 900}
      ImageSearchParameters:
