        _isEnabled: 1
        _value: 1
      HasArrived:
        _isEnabled: 1
        _value: 1
      StartingAnchorPosition:
        _isEnabled: 0
        _value: {x: 0, y: 0}
      StartingDimensions:
        _isEnabled: 1
        _value: {x: 750, y: 900}
      ImageSearchParameters:
        _isEnabled: 1
        _value:
          _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
          _imageType: 10
          _version: 1
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 21300000, guid: de5d207350c794be486f4fffe7f061b2, type: 3}
    hasSFX: 0
    soundEffect: {fileID: 8300000, guid: f45c87f50355e3a4e933dfae013f360b, type: 3}
    _line: '(Or rather, since stalling him out directly didn''t work, regrouping
      to figure out how I can help Ben should do the trick.)

'
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
