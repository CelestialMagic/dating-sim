        _isEnabled: 1
        _value:
          _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
          _imageType: 5
          _version: 1
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 0}
    hasSFX: 0
    soundEffect: {fileID: 8300000, guid: e0490554704e0794598069fedb191f38, type: 3}
    _line: Ben is visibly hurt, but he's trying his best not to show it. Despite
      his compromised appearance, you feel a pang of guilt for the poor guy.
    _speakerProperties:
    - _speakerType: 0
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
    - _spriteIndex: 0
      IsSubject:
        _isEnabled: 1
        _value: 1
      IsRevealed:
        _isEnabled: 1
        _value: 1
      HasArrived:
        _isEnabled: 1
        _value: 1
      StartingAnchorPosition:
        _isEnabled: 0
        _value: {x: 0, y: 0}
      StartingDimensions:
        _isEnabled: 1
        _value: {x: 750, y: 900}
      ImageSearchParameters:
        _isEnabled: 1
        _value:
          _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
          _imageType: 5
          _version: 1
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 0}
    hasSFX: 0
    soundEffect: {fileID: 8300000, guid: e0490554704e0794598069fedb191f38, type: 3}
    _line: But for his safety and your own, you feel this is the best option. Now
      to leave, and get him some help.
    _speakerProperties:
    - _speakerType: 0
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
    - _spriteIndex: 0
      IsSubject:
        _isEnabled: 1
