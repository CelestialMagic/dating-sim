    soundEffect: {fileID: 8300000, guid: e0490554704e0794598069fedb191f38, type: 3}
    _line: Yeah, uh, that makes sense. A little forward of me, huh. Ha ha...
    _speakerProperties:
    - _speakerType: 2
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
