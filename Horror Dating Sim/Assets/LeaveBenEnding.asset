        _value:
          _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
          _imageType: 5
          _version: 1
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
