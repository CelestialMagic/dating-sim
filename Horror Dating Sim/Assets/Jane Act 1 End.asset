          _version: 1
  - hasBackground: 0
    background: {fileID: 0}
    _line: "Y\u2019know, the county fair is in town this week. How about we meet
      up tomorrow around 4:00 pm? You should be out of your classes by then."
    _speakerProperties:
    - _speakerType: 2
