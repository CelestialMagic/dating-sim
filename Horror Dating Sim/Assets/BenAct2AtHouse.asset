    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: So, Ben, what do you wanna do? Got any party games or anything?
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
    - _spriteIndex: 0
      IsSubject:
        _isEnabled: 1
        _value: 1
      IsRevealed:
        _isEnabled: 1
        _value: 1
      HasArrived:
        _isEnabled: 1
        _value: 1
      StartingAnchorPosition:
        _isEnabled: 0
