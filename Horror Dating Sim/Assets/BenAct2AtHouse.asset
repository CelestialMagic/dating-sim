    hasBackground: 0
    background: {fileID: 21300000, guid: f4ec4e5eca95145dabda9d7966da008b, type: 3}
    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: '(No. Way. Is he... saying what I think he''s saying?)

'
