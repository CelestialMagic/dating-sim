    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: Ooh, that's a good idea, yeah! Here, the backyard's this way. That's where
      that pool I mentioned earlier is, too.
    _speakerProperties:
    - _speakerType: 2
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
