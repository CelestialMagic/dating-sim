    hasBackground: 0
    background: {fileID: 21300000, guid: f4ec4e5eca95145dabda9d7966da008b, type: 3}
    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: '(Nah, no need to overthink it. Time to enjoy a little quality time.)

'
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
