  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 21300000, guid: f4ec4e5eca95145dabda9d7966da008b, type: 3}
    hasBackground: 1
    background: {fileID: 21300000, guid: f4ec4e5eca95145dabda9d7966da008b, type: 3}
    hasSFX: 1
    soundEffect: {fileID: 8300000, guid: e0490554704e0794598069fedb191f38, type: 3}
    _line: Hope you didn't hit too much traffic on your way. But uh, yeah, welcome
      to my house! Make yourself at home, and don't mind my buds, either.
    _speakerProperties:
    - _speakerType: 2
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
    - _spriteIndex: 0
      IsSubject:
        _isEnabled: 1
        _value: 1
      IsRevealed:
        _isEnabled: 1
        _value: 1
      HasArrived:
        _isEnabled: 1
        _value: 1
      StartingAnchorPosition:
        _isEnabled: 0
        _value: {x: 0, y: 0}
      StartingDimensions:
        _isEnabled: 1
        _value: {x: 750, y: 900}
      ImageSearchParameters:
        _isEnabled: 1
        _value:
          _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
          _imageType: 1
          _version: 1
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 21300000, guid: f4ec4e5eca95145dabda9d7966da008b, type: 3}
    hasBackground: 0
    background: {fileID: 21300000, guid: f4ec4e5eca95145dabda9d7966da008b, type: 3}
    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: (Hmm... doesn't seem like there are too many people here at all. I wonder
      if that's because Ben was looking out for me, or...)
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
    - _spriteIndex: 0
      IsSubject:
        _isEnabled: 1
        _value: 1
      IsRevealed:
        _isEnabled: 1
        _value: 1
      HasArrived:
        _isEnabled: 1
        _value: 1
      StartingAnchorPosition:
        _isEnabled: 0
        _value: {x: 0, y: 0}
      StartingDimensions:
        _isEnabled: 1
        _value: {x: 750, y: 900}
      ImageSearchParameters:
        _isEnabled: 1
        _value:
          _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
          _imageType: 0
          _version: 1
  - _newBackground:
