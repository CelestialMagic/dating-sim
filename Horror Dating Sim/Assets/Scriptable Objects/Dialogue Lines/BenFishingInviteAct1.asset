  _spriteCount: 1
  _dialogueLines:
  - hasBackground: 0
    background: {fileID: 0}
    _line: Y'know, I was actually thinking of going fishing at this local spot I
      know near campus this afternoon. If you don't have classes, wanna come with
      me?
    _speakerProperties:
    - _speakerType: 2
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
