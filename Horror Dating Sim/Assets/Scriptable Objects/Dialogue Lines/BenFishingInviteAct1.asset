          _imageType: 0
          _version: 1
  - hasBackground: 0
    background: {fileID: 0}
    _line: Sure, I'd love to!
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
