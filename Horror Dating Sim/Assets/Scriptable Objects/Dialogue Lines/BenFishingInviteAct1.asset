          _imageType: 4
          _version: 1
  - hasBackground: 0
    background: {fileID: 0}
    _line: (This is the perfect chance to get close to Ben. I've gotta seize this
      opportunity!)
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
