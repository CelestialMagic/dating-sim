          _version: 1
  - hasBackground: 0
    background: {fileID: 0}
    _line: Ben hefts his bag over one shoulder, then saunters out of class. He seems
      just as excited as you are about this.
    _speakerProperties:
    - _speakerType: 0
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
