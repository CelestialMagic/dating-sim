        _value: {x: 0, y: 0}
      StartingDimensions:
        _isEnabled: 1
        _value: {x: 750, y: 900}
      ImageSearchParameters:
        _isEnabled: 1
        _value:
          _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
          _imageType: 4
          _version: 1
  - hasBackground: 0
    background: {fileID: 0}
    _line: Well alright! Here, gimme your phone number. I'll text ya the GPS location
      for the spot, and we'll meet up around 3:00. Oh, and I'll bring the gear we
      need, too, so don't worry about that.
    _speakerProperties:
    - _speakerType: 2
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
