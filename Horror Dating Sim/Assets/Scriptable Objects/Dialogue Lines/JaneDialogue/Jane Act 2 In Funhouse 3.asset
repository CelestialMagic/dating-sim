    hasSFX: 1
    soundEffect: {fileID: 8300000, guid: f9f1412e2ebd12d49a15e4db911089d2, type: 3}
    _line: "It\u2019s, it\u2019s a fire! Oh I knew it! I knew this rickety fair wasn\u2019t
      up to safety standards!"
    _speakerProperties:
    - _speakerType: 2
      _name: 
      _profile: {fileID: 11400000, guid: 1603b509e368b9145a3d489efc3e9ea1, type: 2}
