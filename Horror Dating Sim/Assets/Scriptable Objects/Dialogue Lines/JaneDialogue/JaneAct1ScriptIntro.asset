    _line: '(Man, school''s always such a drag. Dreary assignments, boring lectures.
      I find myself barely smiling anymore.)

'
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings: []
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 0}
    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: "(Seems like everyday there\u2019s a test to study for, a project to have
      meetings on, or a new paper to write. I\u2019m not sure if I\u2019ll survive
      another quarter of this.)\n"
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings: []
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 0}
    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: "(Today I\u2019m at the library. I decided that for my last GE botany
      would suffice. Who would\u2019ve thought that you needed so many books for
      botany?)\n"
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
