  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 0}
    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: "It\u2019s\u2026 Jane! She\u2019s been a classmate of yours for a few
      classes, but you\u2019ve never really had a chance to talk with each other."
    _speakerProperties:
    - _speakerType: 0
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
    - _spriteIndex: 0
      IsSubject:
        _isEnabled: 1
        _value: 0
      IsRevealed:
        _isEnabled: 1
        _value: 1
      HasArrived:
        _isEnabled: 1
        _value: 1
      StartingAnchorPosition:
        _isEnabled: 0
        _value: {x: 0, y: 0}
      StartingDimensions:
        _isEnabled: 1
        _value: {x: 750, y: 900}
      ImageSearchParameters:
        _isEnabled: 1
        _value:
          _profile: {fileID: 11400000, guid: 1603b509e368b9145a3d489efc3e9ea1, type: 2}
          _imageType: 0
          _version: 1
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 0}
    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: "It\u2019s the first time you\u2019ve met her outside of class, and finally
      an opportunity to talk! But she seems to have some pretty bad bags under her
      eyes, is she getting enough sleep?"
    _speakerProperties:
    - _speakerType: 0
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
    - _spriteIndex: 0
      IsSubject:
        _isEnabled: 1
        _value: 0
      IsRevealed:
        _isEnabled: 1
        _value: 1
      HasArrived:
        _isEnabled: 1
        _value: 1
      StartingAnchorPosition:
        _isEnabled: 0
        _value: {x: 0, y: 0}
      StartingDimensions:
        _isEnabled: 1
        _value: {x: 750, y: 900}
      ImageSearchParameters:
        _isEnabled: 1
        _value:
          _profile: {fileID: 11400000, guid: 1603b509e368b9145a3d489efc3e9ea1, type: 2}
          _imageType: 0
          _version: 1
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 0}
    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: "You both apologize and begin helping each other pick up the scattered
      books. You notice that she had a few hunting books and a journal, but also
      a book with a white lily drawn on it. It\u2019s the book you\u2019ve been looking
      for."
    _speakerProperties:
    - _speakerType: 0
      _name: 
      _profile: {fileID: 11400000, guid: 1603b509e368b9145a3d489efc3e9ea1, type: 2}
    _characterSpriteSettings:
    - _spriteIndex: 0
      IsSubject:
        _isEnabled: 1
        _value: 0
      IsRevealed:
        _isEnabled: 1
        _value: 1
      HasArrived:
        _isEnabled: 1
        _value: 1
      StartingAnchorPosition:
        _isEnabled: 0
        _value: {x: 0, y: 0}
      StartingDimensions:
        _isEnabled: 1
        _value: {x: 750, y: 900}
      ImageSearchParameters:
        _isEnabled: 1
        _value:
          _profile: {fileID: 11400000, guid: 1603b509e368b9145a3d489efc3e9ea1, type: 2}
          _imageType: 0
          _version: 1
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 0}
    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: "Thanks for the help, stranger. I don\u2019t believe I caught a name?"
    _speakerProperties:
    - _speakerType: 2
      _name: 
      _profile: {fileID: 11400000, guid: 1603b509e368b9145a3d489efc3e9ea1, type: 2}
