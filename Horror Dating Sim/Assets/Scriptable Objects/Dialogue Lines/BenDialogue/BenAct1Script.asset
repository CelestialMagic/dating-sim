    soundEffect: {fileID: 8300000, guid: fb2d001fa4be1164b9783460ec0c5df1, type: 3}
    _line: Oh, hey there. I don't think we've met before, have we?
    _speakerProperties:
    - _speakerType: 2
      _name: 
