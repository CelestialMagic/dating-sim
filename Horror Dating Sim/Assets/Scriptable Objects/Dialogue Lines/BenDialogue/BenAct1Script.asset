        _value:
          _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
          _imageType: 0
          _version: 1
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 0}
    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: '(This guy''s name is Ben Trawler. I''ve heard of him on a few occasions
      since last quarter, but this is my first time seeing him in the flesh.)

'
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
    - _spriteIndex: 0
      IsSubject:
        _isEnabled: 1
        _value: 0
      IsRevealed:
        _isEnabled: 1
        _value: 1
      HasArrived:
        _isEnabled: 1
        _value: 1
      StartingAnchorPosition:
        _isEnabled: 0
        _value: {x: 0, y: 0}
      StartingDimensions:
        _isEnabled: 1
        _value: {x: 750, y: 900}
      ImageSearchParameters:
        _isEnabled: 1
        _value:
          _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
          _imageType: 0
          _version: 1
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 0}
    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: '(Oh, shoot. The professor''s coming in now. Guess I''d better get ready
      for class.)

'
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
    - _spriteIndex: 0
      IsSubject:
        _isEnabled: 1
        _value: 0
      IsRevealed:
        _isEnabled: 1
        _value: 0
      HasArrived:
        _isEnabled: 1
        _value: 0
      StartingAnchorPosition:
        _isEnabled: 0
        _value: {x: 0, y: 0}
      StartingDimensions:
        _isEnabled: 1
        _value: {x: 750, y: 900}
      ImageSearchParameters:
        _isEnabled: 1
        _value:
          _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
          _imageType: 0
          _version: 1
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 0}
    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: '(Hm, that... actually wasn''t too bad! I only took this marine biology
      class to fulfill my general education requirements, but it''s honestly kinda
      interesting.)

'
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
    - _spriteIndex: 0
      IsSubject:
        _isEnabled: 1
        _value: 0
      IsRevealed:
        _isEnabled: 1
        _value: 0
      HasArrived:
        _isEnabled: 1
        _value: 0
      StartingAnchorPosition:
        _isEnabled: 0
        _value: {x: 0, y: 0}
      StartingDimensions:
        _isEnabled: 1
        _value: {x: 750, y: 900}
      ImageSearchParameters:
        _isEnabled: 1
        _value:
          _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
          _imageType: 0
          _version: 1
  - _newBackground:
      _isEnabled: 0
      _value: {fileID: 0}
    hasBackground: 0
    background: {fileID: 0}
    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: '(I couldn''t help but notice that Ben was sitting at attention, nodding
      along to everything the teacher said, too. Maybe he likes marine life?)

'
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
    - _spriteIndex: 0
      IsSubject:
        _isEnabled: 1
