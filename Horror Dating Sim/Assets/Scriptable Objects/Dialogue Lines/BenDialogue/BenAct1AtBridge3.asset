    hasSFX: 1
    soundEffect: {fileID: 8300000, guid: 57219506f5822de43b8c7a9d4e6b1e3d, type: 3}
    _line: That's... nice of you to say, actually.  I had a fun time hanging out
      with you, too! We oughta do this again soon.
    _speakerProperties:
    - _speakerType: 2
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
