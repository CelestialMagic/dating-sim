    background: {fileID: 0}
    hasSFX: 0
    soundEffect: {fileID: 0}
    _line: I had a lot of fun, Ben! But I think my favorite part was just getting
      to spend time with you!
    _speakerProperties:
    - _speakerType: 1
      _name: 
      _profile: {fileID: 11400000, guid: cef2e72371f654a43b43317c22347f40, type: 2}
    _characterSpriteSettings:
